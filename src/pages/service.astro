---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { servicePackages, serviceItems, serviceSteps, serviceFaqs } from '../data/services';
import { company } from '../data/company';
import { listedBikes } from '../data/bikes';
import { formatPrice } from '../lib/format';
import { bikePhoto } from '../lib/images';

const workshopPhoto = bikePhoto('voltwerk-workshop-1.jpg');

// Cheapest entry point across both lists. Used in the hero so the first number
// someone sees is the smallest one, not the most expensive package.
const cheapest = Math.min(
  ...servicePackages.map((p) => p.priceEur),
  ...serviceItems.map((i) => i.priceEur),
);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: serviceFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Service and repairs"
  description={`E-bike servicing and repairs in Amsterdam from €${cheapest}. Battery diagnostics, motor work and full services on Bosch, Shimano, Yamaha, Brose and Bafang systems.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <!-- Hero --------------------------------------------------------------- -->
  <section
    class="shell grid items-center gap-10 pt-12 pb-14 md:pt-16 lg:grid-cols-2 lg:gap-16 lg:pb-20"
  >
    <div>
      <p class="text-label text-ink-faint uppercase">The workshop</p>
      <h1 class="text-h1 mt-4">Repairs and servicing for any e-bike.</h1>
      <p class="text-lead text-ink-muted mt-6">
        The same workshop that checks every bike we sell. We work on bikes bought anywhere, we quote
        before we start, and we tell you when a repair is not worth the money.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="#book" size="lg">Book a repair</Button>
        <Button href="#prices" variant="secondary" size="lg">See prices</Button>
      </div>
      <p class="text-ink-muted mt-6 text-sm">
        Walk in at {company.address.street}, or call
        <a
          href={company.phoneHref}
          class="text-ink decoration-lime underline decoration-2 underline-offset-4"
        >
          {company.phone}
        </a>.
      </p>
    </div>

    {
      workshopPhoto && (
        <div class="bg-paper-sunk aspect-[4/3] overflow-hidden rounded-lg">
          <Image
            src={workshopPhoto}
            alt="A bicycle on a repair stand in the VOLTWERK workshop"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
  </section>

  <!-- Packages ----------------------------------------------------------- -->
  <section id="packages" class="border-line bg-paper-sunk border-y py-14 md:py-20">
    <div class="shell">
      <h2 class="text-h2">Service packages</h2>
      <p class="text-lead text-ink-muted mt-4 max-w-xl">
        Fixed prices, no surprises. If we find something outside the package we call you with a
        quote before touching it.
      </p>

      {
        /* The middle tier is marked, because an unmarked three way choice makes
          people stall. It is also genuinely the right answer for most used
          bikes, so the nudge is honest. */
      }
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          servicePackages.map((pkg) => (
            <div
              class:list={[
                'bg-card flex flex-col rounded-lg border p-7',
                pkg.popular ? 'border-ink shadow-card' : 'border-line',
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-h3">{pkg.name}</h3>
                {pkg.popular && (
                  <span class="text-label bg-lime text-ink shrink-0 rounded-full px-2.5 py-1 uppercase">
                    Most booked
                  </span>
                )}
              </div>

              <p class="text-ink-muted mt-3 text-sm">{pkg.tagline}</p>

              <p class="tabular mt-6 font-mono text-3xl font-semibold">
                {formatPrice(pkg.priceEur)}
              </p>
              <p class="text-ink-faint mt-1.5 text-sm">{pkg.durationLabel}</p>

              <ul class="border-line mt-6 flex-1 space-y-2.5 border-t pt-6">
                {pkg.includes.map((item) => (
                  <li class="flex gap-2.5 text-sm">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      class="text-available mt-0.5 shrink-0"
                      aria-hidden="true"
                    >
                      <path
                        d="M3.5 8.5l3 3 6-6.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>

              <Button
                href="#book"
                variant={pkg.popular ? 'primary' : 'secondary'}
                class="mt-7 w-full"
              >
                Book {pkg.name}
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process ------------------------------------------------------------ -->
  <section class="shell py-14 md:py-20">
    <h2 class="text-h2">How it works</h2>
    <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
      {
        serviceSteps.map((step, i) => (
          <li class="border-ink border-t-2 pt-5">
            <span class="tabular text-ink-faint font-mono text-sm">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-h3 mt-2">{step.title}</h3>
            <p class="text-ink-muted mt-3 text-sm leading-relaxed">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Price list --------------------------------------------------------- -->
  <section id="prices" class="border-line border-t py-14 md:py-20">
    <div class="shell grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
      <div>
        <h2 class="text-h2">Individual jobs</h2>
        <p class="text-ink-muted mt-4">
          Prices marked "from" depend on the parts your bike takes. We confirm the exact figure
          before we start.
        </p>
        <p class="text-ink-muted mt-4 text-sm">
          Labour is charged at &euro; 60 per hour for anything not listed here.
        </p>
      </div>

      {
        /* Battery work is first in the data and stays first here. It is the most
          common reason someone brings a used e-bike in and the most expensive
          thing to get wrong, so it should be the first price a worried owner
          sees. */
      }
      <dl class="border-line border-t">
        {
          serviceItems.map((item) => (
            <div class="border-line flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b py-4">
              <dt class="min-w-0 flex-1">
                <span class="font-medium">{item.name}</span>
                <span class="text-ink-muted mt-0.5 block text-sm">{item.description}</span>
              </dt>
              <dd class="tabular shrink-0 text-right font-mono">
                {item.from && <span class="text-ink-faint mr-1 text-xs">from</span>}
                {formatPrice(item.priceEur)}
                {item.durationLabel && (
                  <span class="text-ink-faint mt-0.5 block font-sans text-xs">
                    {item.durationLabel}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Booking ------------------------------------------------------------ -->
  <section id="book" class="border-line bg-paper-sunk border-y py-14 md:py-20">
    <div class="shell grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
      <div>
        <h2 class="text-h2">Book a repair</h2>
        <p class="text-lead text-ink-muted mt-4">
          Tell us roughly what the bike is doing. We will come back with a time slot and, where we
          can, a price estimate.
        </p>
        <div class="mt-8 space-y-3 text-sm">
          <p class="text-ink-muted">Prefer to talk?</p>
          <div class="flex flex-wrap gap-3">
            <Button href={company.phoneHref} variant="secondary">Call {company.phone}</Button>
            <Button href={company.whatsapp} variant="secondary">WhatsApp</Button>
          </div>
        </div>
      </div>

      <form id="booking-form" class="border-line bg-card rounded-lg border p-6 sm:p-8" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="b-name" class="text-label text-ink-faint block uppercase">Your name</label>
            <input
              type="text"
              id="b-name"
              name="name"
              required
              autocomplete="name"
              class="border-line-strong bg-paper mt-2 h-11 w-full rounded-sm border px-3 text-sm"
            />
          </div>

          <div>
            <label for="b-email" class="text-label text-ink-faint block uppercase">Email</label>
            <input
              type="email"
              id="b-email"
              name="email"
              required
              autocomplete="email"
              class="border-line-strong bg-paper mt-2 h-11 w-full rounded-sm border px-3 text-sm"
            />
          </div>

          <div>
            <label for="b-phone" class="text-label text-ink-faint block uppercase">
              Phone <span class="normal-case">(optional)</span>
            </label>
            <input
              type="tel"
              id="b-phone"
              name="phone"
              autocomplete="tel"
              class="border-line-strong bg-paper mt-2 h-11 w-full rounded-sm border px-3 text-sm"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="b-service" class="text-label text-ink-faint block uppercase">
              What do you need
            </label>
            <select
              id="b-service"
              name="service"
              class="border-line-strong bg-paper mt-2 h-11 w-full rounded-sm border px-3 text-sm"
            >
              <option value="">I am not sure yet</option>
              {servicePackages.map((p) => <option value={p.slug}>{p.name}</option>)}
              <option value="other">Something else</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label for="b-bike" class="text-label text-ink-faint block uppercase">
              Bike make and model
            </label>
            <input
              type="text"
              id="b-bike"
              name="bike"
              placeholder="e.g. Gazelle Ultimate C380, 2022"
              class="border-line-strong bg-paper mt-2 h-11 w-full rounded-sm border px-3 text-sm"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="b-message" class="text-label text-ink-faint block uppercase">
              What is it doing
            </label>
            <textarea
              id="b-message"
              name="message"
              rows="4"
              placeholder="Rattling from the motor when I pedal hard, started last week."
              class="border-line-strong bg-paper mt-2 w-full rounded-sm border px-3 py-2.5 text-sm"
            ></textarea>
          </div>
        </div>

        <Button type="submit" size="lg" class="mt-6 w-full sm:w-auto">Send request</Button>

        <p class="text-ink-faint mt-4 text-xs">
          This is a design prototype, so nothing is actually sent anywhere.
        </p>

        {
          /* Success state replaces the form rather than sitting above it, so
            there is no ambiguity about whether it went through. */
        }
        <div
          id="booking-success"
          hidden
          role="status"
          class="border-available/30 bg-available/8 rounded-md border p-6 text-center"
        >
          <p class="font-display text-xl font-semibold">Request received</p>
          <p class="text-ink-muted mx-auto mt-2 max-w-sm text-sm">
            In a real build this would land in the workshop inbox and you would get a confirmation
            within one working day.
          </p>
          <button
            type="button"
            id="booking-reset"
            class="decoration-lime mt-5 text-sm font-medium underline decoration-2 underline-offset-4"
          >
            Send another request
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- FAQ ---------------------------------------------------------------- -->
  <section class="shell py-14 md:py-20">
    <h2 class="text-h2">Common questions</h2>
    {
      /* Native details and summary. An accordion is one of the few widgets the
        platform already ships correctly, including keyboard and screen reader
        behaviour, so writing one in JavaScript would be a downgrade. */
    }
    <div class="border-line mt-8 max-w-3xl border-t">
      {
        serviceFaqs.map((faq) => (
          <details class="faq group border-line border-b">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5">
              <span class="font-medium">{faq.q}</span>
              <span class="text-ink-faint mt-1 shrink-0 transition-transform group-open:rotate-45">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M8 3v10M3 8h10"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <p class="text-ink-muted max-w-2xl pb-5 text-sm leading-relaxed">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Cross sell --------------------------------------------------------- -->
  <section class="border-line bg-ink text-paper border-t py-14 md:py-20">
    <div
      class="shell flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div>
        <h2 class="text-h2">Looking for a bike, not a repair?</h2>
        <p class="text-paper/70 mt-3">
          {listedBikes.length} used e-bikes in stock, each one through the same workshop.
        </p>
      </div>
      <Button
        href="/bikes"
        variant="secondary"
        size="lg"
        class="border-paper/25 text-paper hover:border-paper hover:bg-paper/10"
      >
        Browse the bikes
      </Button>
    </div>
  </section>
</Base>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }
</style>

<script>
  function initBookingForm() {
    const form = document.getElementById('booking-form') as HTMLFormElement | null;
    const success = document.getElementById('booking-success');
    const reset = document.getElementById('booking-reset');
    if (!form || !success) return;

    const fields = form.querySelectorAll<HTMLElement>('.grid, button[type="submit"], p.text-xs');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // checkValidity uses the browser's own required and type validation, so
      // the error messages are native, localised and announced correctly.
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      fields.forEach((el) => (el.hidden = true));
      success.hidden = false;
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    reset?.addEventListener('click', () => {
      form.reset();
      success.hidden = true;
      fields.forEach((el) => (el.hidden = false));
    });
  }

  document.addEventListener('astro:page-load', initBookingForm);
</script>
