---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BikeCard from '../components/BikeCard.astro';
import Button from '../components/ui/Button.astro';
import { listedBikes, featuredBikes } from '../data/bikes';
import { servicePackages, serviceItems } from '../data/services';
import { company, inspectionPoints } from '../data/company';
import { formatPrice } from '../lib/format';
import { bikePhoto } from '../lib/images';

const hero = bikePhoto('voltwerk-hero.jpg');
const workshop = bikePhoto('voltwerk-workshop-2.jpg');

const cheapestService = Math.min(...serviceItems.map((i) => i.priceEur));
const fromPrice = Math.min(...listedBikes.map((b) => b.price));

// Median battery health across the floor. A single honest aggregate says more
// than a slogan, and it is a number a competitor cannot copy without doing the
// same testing.
const healths = listedBikes.map((b) => b.battery.healthPct).sort((a, b) => a - b);
const medianHealth = healths[Math.floor(healths.length / 2)];
---

<Base>
  <!-- Hero --------------------------------------------------------------- -->
  <section
    class="shell grid items-center gap-10 pt-12 pb-14 md:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16 lg:pt-20 lg:pb-24"
  >
    <div>
      <p class="text-label text-ink-faint uppercase">Used e-bikes &middot; Amsterdam</p>
      <h1 class="text-display mt-5">Used e-bikes, properly checked.</h1>
      <p class="text-lead text-ink-muted mt-6 max-w-lg">
        Every bike we sell has had its battery tested on a rig, its motor read for faults and its
        wear written down in plain language. You see the numbers before you come in.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="/bikes" size="lg">Browse {listedBikes.length} bikes</Button>
        <Button href="/service" variant="secondary" size="lg">Repairs and servicing</Button>
      </div>

      {
        /* Three numbers pulled from the actual inventory. If a bike sells or a
          battery reading changes, this block changes with it. */
      }
      <dl class="border-line mt-12 grid max-w-lg grid-cols-3 gap-4 border-t pt-7">
        <div>
          <dt class="text-label text-ink-faint uppercase">In stock</dt>
          <dd class="tabular mt-1.5 font-mono text-2xl font-semibold">{listedBikes.length}</dd>
        </div>
        <div>
          <dt class="text-label text-ink-faint uppercase">Median battery</dt>
          <dd class="tabular mt-1.5 font-mono text-2xl font-semibold">{medianHealth}%</dd>
        </div>
        <div>
          <dt class="text-label text-ink-faint uppercase">From</dt>
          <dd class="tabular mt-1.5 font-mono text-2xl font-semibold">{formatPrice(fromPrice)}</dd>
        </div>
      </dl>
    </div>

    {
      hero && (
        <div class="bg-paper-sunk aspect-[4/3] overflow-hidden rounded-lg lg:aspect-[5/4]">
          <Image
            src={hero}
            alt="An electric bicycle in the VOLTWERK workshop"
            widths={[600, 900, 1300]}
            sizes="(min-width: 1024px) 48vw, 92vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
  </section>

  <!-- Featured ----------------------------------------------------------- -->
  <section class="border-line border-t py-14 md:py-20">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-h2">Just in</h2>
          <p class="text-ink-muted mt-3">Recently inspected and ready to ride away.</p>
        </div>
        <a
          href="/bikes"
          class="decoration-lime text-sm font-medium underline decoration-2 underline-offset-4"
        >
          See all {listedBikes.length} bikes
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {featuredBikes.map((bike, i) => <BikeCard bike={bike} priority={i < 2} />)}
      </div>
    </div>
  </section>

  <!-- Inspection --------------------------------------------------------- -->
  <section class="border-line bg-paper-sunk border-y py-14 md:py-20">
    <div class="shell grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="text-label text-ink-faint uppercase">Before it goes on sale</p>
        <h2 class="text-h2 mt-4">
          {inspectionPoints.length} things we check on every bike.
        </h2>
        <p class="text-lead text-ink-muted mt-5">
          Buying used is mostly a question of what you cannot see. This is the list we work through,
          and anything we find goes on the bike's page whether it helps the sale or not.
        </p>
        <Button href="/bikes" class="mt-8">See what is in stock</Button>
      </div>

      {
        /* The full list, not a summarised three. The length is the point: a
          claim of "fully checked" is worth nothing next to an itemised list
          someone can hold you to. */
      }
      <ol class="grid gap-x-8 gap-y-0 sm:grid-cols-2">
        {
          inspectionPoints.map((point, i) => (
            <li class="border-line flex gap-3 border-b py-3">
              <span class="tabular text-ink-faint mt-0.5 font-mono text-xs">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-sm">{point}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Service teaser ----------------------------------------------------- -->
  <section class="shell py-14 md:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      {
        workshop && (
          <div class="bg-paper-sunk order-2 aspect-[4/3] overflow-hidden rounded-lg lg:order-1">
            <Image
              src={workshop}
              alt="A mechanic working on a bicycle drivetrain"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 46vw, 92vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        )
      }

      <div class="order-1 lg:order-2">
        <p class="text-label text-ink-faint uppercase">The workshop</p>
        <h2 class="text-h2 mt-4">We also fix the ones we did not sell.</h2>
        <p class="text-lead text-ink-muted mt-5">
          Battery diagnostics, motor faults, brakes, drivetrains. Bosch, Shimano, Yamaha, Brose and
          Bafang systems. We quote before we start and we will tell you when a repair is not worth
          the money.
        </p>

        <dl class="border-line mt-8 space-y-3 border-t pt-6">
          {
            servicePackages.map((pkg) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-sm">{pkg.name}</dt>
                <dd class="tabular font-mono text-sm font-medium">{formatPrice(pkg.priceEur)}</dd>
              </div>
            ))
          }
          <div class="border-line flex items-baseline justify-between gap-4 border-t pt-3">
            <dt class="text-ink-muted text-sm">Individual jobs from</dt>
            <dd class="tabular font-mono text-sm font-medium">{formatPrice(cheapestService)}</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/service">Book a repair</Button>
          <Button href="/service#prices" variant="secondary">Full price list</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit -------------------------------------------------------------- -->
  <section class="border-line border-t py-14 md:py-20">
    <div class="shell grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-h2">Come and ride one.</h2>
        <p class="text-lead text-ink-muted mt-4">
          No appointment needed. Bring your own bike in for a trade against anything on the floor.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3 lg:col-span-2">
        <div>
          <h3 class="text-label text-ink-faint uppercase">Address</h3>
          <address class="mt-3 text-sm leading-relaxed not-italic">
            {company.address.street}<br />
            {company.address.postcode}
            {company.address.city}<br />
            {company.address.country}
          </address>
        </div>
        <div>
          <h3 class="text-label text-ink-faint uppercase">Opening hours</h3>
          <dl class="mt-3 space-y-1.5 text-sm">
            {
              company.hours.map((slot) => (
                <div class="flex justify-between gap-3">
                  <dt class="text-ink-muted">{slot.days}</dt>
                  <dd class="tabular font-mono">
                    {slot.open}&ndash;{slot.close}
                  </dd>
                </div>
              ))
            }
            <div class="flex justify-between gap-3">
              <dt class="text-ink-muted">Sunday</dt>
              <dd>Closed</dd>
            </div>
          </dl>
        </div>
        <div>
          <h3 class="text-label text-ink-faint uppercase">Get in touch</h3>
          <div class="mt-3 space-y-1.5 text-sm">
            <p>
              <a
                href={company.phoneHref}
                class="decoration-lime underline decoration-2 underline-offset-4"
              >
                {company.phone}
              </a>
            </p>
            <p>
              <a
                href={`mailto:${company.email}`}
                class="decoration-lime underline decoration-2 underline-offset-4"
              >
                {company.email}
              </a>
            </p>
            <p>
              <a
                href={company.whatsapp}
                class="decoration-lime underline decoration-2 underline-offset-4">WhatsApp</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
