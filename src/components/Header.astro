---
import { company } from '../data/company';
import { listedBikes } from '../data/bikes';
import MobileNav from './MobileNav.astro';

const path = Astro.url.pathname;

const nav = [
  { href: '/bikes', label: 'Bikes for sale' },
  { href: '/service', label: 'Service & repairs' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const stockCount = listedBikes.length;
---

<header
  class="border-line bg-paper/85 sticky top-0 z-40 border-b backdrop-blur-md transition-shadow duration-300 data-[scrolled]:shadow-[0_1px_16px_-8px_rgb(15_15_14/0.35)]"
>
  <div class="shell flex h-16 items-center justify-between gap-4 md:h-20">
    <a
      href="/"
      class="font-display text-xl leading-none font-bold tracking-tight md:text-2xl"
      aria-label={`${company.name} home`}
    >
      VOLTWERK
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'group rounded-sm px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href) ? 'text-ink' : 'text-ink-muted hover:text-ink',
            ]}
          >
            <span class="relative">
              {item.label}
              <span
                class:list={[
                  'bg-lime absolute -bottom-1.5 left-0 h-0.5 w-full origin-left rounded-full transition-transform duration-200',
                  isActive(item.href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                ]}
              />
            </span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={company.phoneHref}
        class="focus-invert bg-ink text-paper hover:bg-ink-muted hidden rounded-sm px-4 py-2 text-sm font-medium transition-colors lg:inline-block"
      >
        Call us
      </a>

      <MobileNav
        nav={nav}
        phone={company.phone}
        phoneHref={company.phoneHref}
        whatsapp={company.whatsapp}
        stockCount={stockCount}
        currentPath={path}
      />
    </div>
  </div>
</header>

<script>
  /* The header lifts off the page once you leave the top of it. Deliberately not
     part of the motion bundle: it is a state, not an animation, so it still works
     on /admin and if that bundle never loads.

     Bound at module scope rather than inside the astro:page-load handler. The
     listener is on window, which survives a view transition, so re-binding it on
     every navigation would stack up a fresh listener each time. */
  function syncHeaderState() {
    const header = document.querySelector('header');
    if (!header) return;
    if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  }

  let frame = 0;
  // passive: this never calls preventDefault, and saying so keeps it off the
  // critical path of the scroll itself.
  window.addEventListener(
    'scroll',
    () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(syncHeaderState);
    },
    { passive: true },
  );

  document.addEventListener('astro:page-load', syncHeaderState);
</script>
