---
import { company } from '../data/company';
import { listedBikes } from '../data/bikes';
import MobileNav from './MobileNav.astro';

const path = Astro.url.pathname;

const nav = [
  { href: '/bikes', label: 'Bikes for sale' },
  { href: '/service', label: 'Service & repairs' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const stockCount = listedBikes.length;
---

<header class="border-line bg-paper/85 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-4 md:h-20">
    <a
      href="/"
      class="font-display text-xl leading-none font-bold tracking-tight md:text-2xl"
      aria-label={`${company.name} home`}
    >
      VOLTWERK
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'group rounded-sm px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href) ? 'text-ink' : 'text-ink-muted hover:text-ink',
            ]}
          >
            <span class="relative">
              {item.label}
              <span
                class:list={[
                  'bg-lime absolute -bottom-1.5 left-0 h-0.5 w-full origin-left rounded-full transition-transform duration-200',
                  isActive(item.href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                ]}
              />
            </span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/bikes"
        class="border-line-strong text-ink-muted hover:border-ink hover:text-ink hidden items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors sm:inline-flex"
      >
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
          <span
            class="bg-available absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
          ></span>
          <span class="bg-available relative inline-flex h-1.5 w-1.5 rounded-full"></span>
        </span>
        <span class="tabular">{stockCount}</span> in stock
      </a>

      <a
        href={company.phoneHref}
        class="focus-invert bg-ink text-paper hover:bg-ink-muted hidden rounded-sm px-4 py-2 text-sm font-medium transition-colors lg:inline-block"
      >
        Call us
      </a>

      <MobileNav
        nav={nav}
        phone={company.phone}
        phoneHref={company.phoneHref}
        whatsapp={company.whatsapp}
        stockCount={stockCount}
        currentPath={path}
      />
    </div>
  </div>
</header>
