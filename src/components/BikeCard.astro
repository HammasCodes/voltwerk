---
import { Image } from 'astro:assets';
import type { Bike } from '../types';
import { bikePhoto, photoAlt } from '../lib/images';
import { formatPrice, formatKm } from '../lib/format';
import BatteryMeter from './ui/BatteryMeter.astro';
import Badge from './ui/Badge.astro';

interface Props {
  bike: Bike;
  priority?: boolean;
}

const { bike, priority = false } = Astro.props;

const photo = bikePhoto(bike.photos[0]);
const isSold = bike.availability === 'sold';
---

{
  /*
  The whole card is one link. A card with a separate "view details" button gives
  people a small target inside a large clickable-looking area, which is the most
  common cause of mis-clicks in a product grid.
*/
}
<article class:list={['group relative', isSold && 'opacity-70']}>
  <a
    href={`/bikes/${bike.slug}`}
    class="focus-visible:outline-ink block rounded-md focus-visible:outline-2 focus-visible:outline-offset-4"
  >
    <div class="bg-paper-sunk relative aspect-[4/3] overflow-hidden rounded-md">
      {
        photo && (
          <Image
            src={photo}
            alt={photoAlt(bike.brand, bike.model, 0, bike.photos.length)}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
            loading={priority ? 'eager' : 'lazy'}
            class:list={[
              'h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]',
              isSold && 'grayscale',
            ]}
            transition:name={`bike-photo-${bike.slug}`}
          />
        )
      }

      {
        bike.availability !== 'available' && (
          <div class="absolute top-3 left-3">
            <Badge availability={bike.availability} class="bg-paper/95 backdrop-blur-sm" />
          </div>
        )
      }

      {
        /* Condition grade sits on the image so it reads before the specs, which
          is the order someone actually assesses a used item in. */
      }
      <span
        class="bg-paper/95 text-ink absolute top-3 right-3 inline-flex h-7 w-7 items-center justify-center rounded-full font-mono text-xs font-semibold backdrop-blur-sm"
        title={`Condition grade ${bike.condition.grade}`}
      >
        {bike.condition.grade}
      </span>
    </div>

    <div class="pt-4">
      <p class="text-label text-ink-faint uppercase">{bike.brand}</p>
      <h3
        class="text-h3 decoration-lime mt-1.5 decoration-2 underline-offset-4 group-hover:underline"
      >
        {bike.model}
      </h3>

      <div class="mt-3 flex items-baseline gap-2">
        <span class="tabular font-mono text-xl font-semibold">{formatPrice(bike.price)}</span>
        {
          bike.priceWas && (
            <span class="tabular text-ink-faint font-mono text-sm line-through">
              {formatPrice(bike.priceWas)}
            </span>
          )
        }
      </div>

      {
        /* Three columns rather than a comma-separated sentence. Fixed positions
          mean the eye compares year to year and price to price straight down a
          column of cards instead of re-reading each line. */
      }
      <dl class="border-line mt-4 grid grid-cols-3 gap-2 border-t pt-4">
        <div>
          <dt class="text-label text-ink-faint uppercase">Year</dt>
          <dd class="tabular mt-1 font-mono text-sm">{bike.year}</dd>
        </div>
        <div>
          <dt class="text-label text-ink-faint uppercase">Mileage</dt>
          <dd class="tabular mt-1 font-mono text-sm">{formatKm(bike.mileageKm)}</dd>
        </div>
        <div>
          <dt class="text-label text-ink-faint uppercase">Frame</dt>
          <dd class="tabular mt-1 font-mono text-sm">
            {bike.frameSize} &middot; {bike.frameSizeCm}cm
          </dd>
        </div>
      </dl>

      <div class="border-line mt-4 border-t pt-4">
        <BatteryMeter battery={bike.battery} />
      </div>
    </div>
  </a>
</article>
