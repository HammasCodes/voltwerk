---
import type { Bike } from '../types';
import BikeCard from './BikeCard.astro';

interface Props {
  bikes: Bike[];
  filterable?: boolean;
  columns?: 2 | 3 | 4;
  class?: string;
}

const { bikes, filterable = false, columns = 3, class: className = '' } = Astro.props;

const cols = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];
---

{
  /*
  Every filterable value is written onto the wrapper as a data attribute. The
  filter script then works purely on the DOM, which means the bike data is never
  serialised into the JavaScript bundle a second time. The page ships one copy
  of the inventory, as HTML.
*/
}
<div id="bike-grid" class:list={['grid grid-cols-1 gap-x-6 gap-y-10 sm:gap-y-12', cols, className]}>
  {
    bikes.map((bike, i) => (
      <div
        class="bike-item"
        data-brand={bike.brand}
        data-category={bike.category}
        data-price={bike.price}
        data-size={bike.frameSize}
        data-grade={bike.condition.grade}
        data-health={bike.battery.healthPct}
        data-mileage={bike.mileageKm}
        data-year={bike.year}
        data-listed={bike.listedOn}
        data-hmin={bike.riderHeightCm[0]}
        data-hmax={bike.riderHeightCm[1]}
        data-frametype={bike.frameType}
      >
        <BikeCard bike={bike} priority={!filterable && i < 3} />
      </div>
    ))
  }
</div>
