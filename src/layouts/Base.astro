---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} image={image} noindex={noindex} />
    <ClientRouter />
    {
      /* Pages inject page-specific structured data here, such as the Product
        schema on a bike listing. */
    }
    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="focus:bg-ink focus:text-paper sr-only rounded-sm focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
